{
  "name": "LDB Lab AI Terminal",
  "short_name": "Terminal",
  "description": "Chat with AI models that run on your own device, in the browser.",
  "id": "/terminal/",
  "start_url": "/terminal/",
  "scope": "/terminal/",
  "display": "standalone",
